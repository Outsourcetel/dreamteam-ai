{
  "name": "dreamteam-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "supabase gen types typescript --project-id rfsvmhcqeiyrxivbmpel --schema public > src/types/database.types.ts",
    "provision:all": "node scripts/provision.mjs",
    "test:unit": "vitest run --config vitest.offline.config.ts",
    "test:isolation": "vitest run tests/tenant-isolation.test.ts",
    "test:invariants": "vitest run tests/knowledge-acl-invariants.test.ts",
    "migrate:status": "node scripts/migration-status.mjs",
    "audit:light-ready": "node scripts/audit-light-ready.mjs --strict",
    "audit:role-gates": "node scripts/audit-role-gates.mjs --strict",
    "audit:silent-refusals": "node scripts/audit-silent-refusals.mjs --strict",
    "baseline:generate": "node scripts/generate-baseline.mjs > supabase/baseline/000_baseline_core.sql",
    "backup:schema": "node scripts/backup-schema.mjs > supabase/baseline/full_schema.sql",
    "backup:data": "node scripts/backup-data.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "certify": "node scripts/certify.mjs",
    "certify:fast": "node scripts/certify.mjs --fast",
    "certify:mutation": "node scripts/certify-mutation-test.mjs",
    "defer": "node scripts/defer.mjs",
    "defer:check": "node scripts/deferred-register.mjs",
    "gate:parity": "node scripts/playbook-gate-parity.mjs",
    "golden-path": "node scripts/golden-path.mjs",
    "dev:sync": "node scripts/sync-dev-migrations.mjs --apply",
    "dev:sync:check": "node scripts/sync-dev-migrations.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:history": "node scripts/benchmark.mjs --history",
    "certify:offline": "node scripts/certify.mjs --offline",
    "audit:toolchain": "npm audit --audit-level=high",
    "migrate:next": "node scripts/migration-next.mjs",
    "audit:anon": "node scripts/anon-probe.mjs",
    "audit:replayable": "node scripts/audit-migration-replayability.mjs",
    "audit:retirement": "node scripts/retirement-candidates.mjs",
    "audit:cron-liveness": "node scripts/cron-detector-liveness.mjs",
    "config:runtime": "node scripts/set-runtime-config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@sentry/react": "^10.64.0",
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.5.2",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.2",
    "vite": "^4.4.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.0"
  }
}
